---
// src/components/Terminal/TerminalWindow.astro
---

<div
  class="w-full max-w-4xl h-[600px] flex flex-col bg-dracula-bg border border-white/10 rounded-xl shadow-2xl overflow-hidden font-mono"
>
  <!-- Terminal Header -->
  <div
    class="flex items-center justify-between px-4 py-3 bg-white/5 border-b border-white/5"
  >
    <div class="flex gap-2">
      <div class="w-3 h-3 rounded-full bg-dracula-red shadow-inner"></div>
      <div class="w-3 h-3 rounded-full bg-dracula-yellow shadow-inner"></div>
      <div class="w-3 h-3 rounded-full bg-dracula-green shadow-inner"></div>
    </div>
    <div class="text-dracula-comment text-sm select-none">
      clodoaldo — zsh — 80x24
    </div>
    <div class="w-12"></div>
    <!-- Spacer -->
  </div>

  <!-- Terminal Content -->
  <div
    id="terminal-content"
    class="flex-1 overflow-y-auto p-6 text-dracula-fg space-y-2 custom-scrollbar"
  >
    <div id="terminal-history">
      <p class="text-dracula-green">
        Welcome to Clodoaldo's Terminal Portfolio.
      </p>
      <p class="text-dracula-comment text-sm mb-4">
        Type 'help' to see available commands.
      </p>
    </div>

    <div class="flex gap-2 items-center group">
      <span class="text-dracula-green font-bold">guest@clodoaldo</span>
      <span class="text-dracula-pink">:</span>
      <span class="text-dracula-purple">~</span>
      <span class="text-dracula-cyan">$</span>
      <div class="relative flex-1">
        <input
          type="text"
          id="terminal-input"
          autofocus
          spellcheck="false"
          autocomplete="off"
          class="w-full bg-transparent border-none outline-none text-dracula-fg p-0 focus:ring-0"
        />
      </div>
    </div>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }
</style>

<script>
  const input = document.getElementById('terminal-input') as HTMLInputElement
  const history = document.getElementById('terminal-history')
  const content = document.getElementById('terminal-content')

  const COMMANDS = {
    help: 'Available commands: about, experience, projects, contact, clear, help',
    about:
      'I am a Software Engineer passionate about terminal-based tools and clean code.',
    experience:
      'Software Engineer @ TechCorp (2021-Present)\nFrontend Dev @ StartupX (2019-2021)',
    projects:
      '1. Portfolio-CLI (Astro)\n2. Task-Manager (Go)\n3. Weather-App (React)',
    contact: 'Email: clodoaldo@example.com\nGitHub: github.com/clodoaldo',
  }

  const createLine = (text: string, isCommand = false) => {
    const div = document.createElement('div')
    if (isCommand) {
      div.className = 'flex gap-2 items-center'
      div.innerHTML = `
        <span class="text-dracula-green font-bold">guest@clodoaldo</span>
        <span class="text-dracula-pink">:</span>
        <span class="text-dracula-purple">~</span>
        <span class="text-dracula-cyan">$</span>
        <span class="text-dracula-fg">${text}</span>
      `
    } else {
      div.className = 'text-dracula-fg whitespace-pre-wrap mb-2'
      div.textContent = text
    }
    return div
  }

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const value = input.value.trim().toLowerCase()

      if (value === 'clear') {
        if (history) history.innerHTML = ''
        input.value = ''
        return
      }

      if (value) {
        history?.appendChild(createLine(value, true))

        const response =
          COMMANDS[value as keyof typeof COMMANDS] ||
          `Command not found: ${value}. Type 'help' for options.`

        // Simulating processing delay
        setTimeout(() => {
          history?.appendChild(createLine(response))
          content?.scrollTo(0, content.scrollHeight)
        }, 100)
      }

      input.value = ''
      content?.scrollTo(0, content.scrollHeight)
    }
  })

  // Always keep input focused
  document.addEventListener('click', () => input?.focus())
</script>
